# Copy to .env (git-ignored) and fill in. Never commit real values.
# The defaults in backend/src/main/resources/application.yml point at the local Docker MySQL.

# Database. Local Docker default shown; for Aiven use the host, port and credentials from its connection page.
DB_URL=jdbc:mysql://localhost:3307/referral_portal?allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=referral
DB_PASSWORD=referral_local
# Aiven example (TLS required):
# DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/defaultdb?sslMode=REQUIRED
# DB_USERNAME=avnadmin
# DB_PASSWORD=<aiven-password>

# Google OAuth (Web application client). Local redirect: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App. Local callback: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Brevo SMTP (port 2525). Used from the work-email verification slice onward.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Where to send users after login. Local dev: the Vite dev server. Production: leave unset (same origin).
APP_FRONTEND_URL=http://localhost:5173

# Sample companies, people and a welcome inbox so every screen has content. Never true for the real launch.
SEED_DEMO=true

# Set to true behind HTTPS (Render).
SESSION_COOKIE_SECURE=false
